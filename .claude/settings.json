{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(ls *)",
      "Bash(gh stack *)",
      "Bash(git worktree remove *)",
      "Bash(git -C /Users/suzuki/ghq/github.com/sunazukin/life-recoding worktree remove *)",
      "mcp__pencil"
    ],
    "defaultMode": "auto"
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Removing git worktrees under /Users/suzuki/ghq/github.com/sunazukin/life-recoding/.claude/worktrees/ with `git worktree remove` / `git -C <repo> worktree remove <path>` (without --force), including a for loop over explicitly listed worktree names, is allowed. This is the routine cleanup done by the daily-cleanup-branches task / cleanup-branches skill after verifying each worktree is clean and merged."
    ]
  },
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_BUG_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "pnpm_config_store_dir": "/Users/suzuki/Library/pnpm/store"
  },
  "cleanupPeriodDays": 30,
  "model": "claude-opus-5",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/notify.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/scripts/check-japanese.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "language": "japanese",
  "sandbox": {
    "enabled": true,
    "excludedCommands": [
      "gh *",
      "git fetch *",
      "git worktree add *",
      "git worktree remove *",
      "git worktree prune",
      "git branch -d *",
      "curl *127.0.0.1:7001/*"
    ],
    "network": {
      "allowUnixSockets": ["/private/tmp/claude-501/tsx-501"]
    },
    "filesystem": {
      "allowWrite": [
        "~/Library/pnpm/store",
        "/private/tmp/pnpm-dir-locks-501",
        "/private/tmp/pnpm-store-operation-locks-501",
        "/private/tmp/pnpm-verify-deps-install-locks-501"
      ]
    }
  }
}
